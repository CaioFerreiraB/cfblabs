---
import '@fontsource-variable/manrope';
import type { Locale, PageName } from '../lib/content';
import { site } from '../lib/content';
import { copy, pageHref } from '../lib/i18n';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props { locale: Locale; page: PageName; title: string; description: string; hero?: boolean; }
const { locale, page, title, description, hero = false } = Astro.props;
const t = copy[locale];
const canonical = new URL(pageHref(locale, page), Astro.site).toString();
const otherLocale: Locale = locale === 'en' ? 'pt' : 'en';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={hero ? '#06182b' : '#f5f7fa'} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === 'en' ? 'pt' : 'en'} href={new URL(pageHref(otherLocale, page), Astro.site).toString()} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={new URL(pageHref('en', page), Astro.site).toString()} />
    <title>{title} | {site.brandName}</title>
  </head>
  <body class:list={[{ 'home-body': hero }]}>
    <a class="skip-link" href="#main-content">{t.skip}</a>
    <Header locale={locale} page={page} light={hero} />
    <main id="main-content"><slot /></main>
    <footer class="site-footer"><span>{site.brandName}</span><span>{t.footer}</span><span>© {new Date().getFullYear()}</span></footer>
  </body>
</html>
