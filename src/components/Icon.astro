---
import {
  ArrowRight, ArrowUpRight, BookOpen, BriefcaseBusiness, Camera, ChartNoAxesCombined,
  CodeXml, GraduationCap, HeartHandshake, Mail,
  MapPin, Microscope, Trees, UsersRound,
} from '@lucide/astro';
import { assetHref } from '../lib/i18n';

interface Props { name: string; size?: number; strokeWidth?: number; class?: string; }
const { name, size = 20, strokeWidth = 1.8, class: className } = Astro.props;
const icons = {
  'arrow-right': ArrowRight,
  'arrow-up-right': ArrowUpRight,
  'book-open': BookOpen,
  'briefcase-business': BriefcaseBusiness,
  camera: Camera,
  'chart-no-axes-combined': ChartNoAxesCombined,
  'code-xml': CodeXml,
  'graduation-cap': GraduationCap,
  'heart-handshake': HeartHandshake,
  mail: Mail,
  'map-pin': MapPin,
  microscope: Microscope,
  trees: Trees,
  'users-round': UsersRound,
};
const Component = icons[name as keyof typeof icons];
if (!Component && name !== 'github' && name !== 'github-white' && name !== 'linkedin' && name !== 'linkedin-white') throw new Error(`Unsupported icon: ${name}`);
---
{name === 'github' || name === 'github-white' ? <img src={assetHref(`/images/logos/github-invertocat-${name === 'github-white' ? 'white' : 'black'}.svg`)} width={size} height={Math.round(size * 96 / 98)} class={className} alt="" aria-hidden="true" /> : name === 'linkedin' || name === 'linkedin-white' ? <img src={assetHref(`/images/logos/${name === 'linkedin-white' ? 'linkedin-in-white' : 'linkedin-in-blue'}.png`)} width={size} height={Math.round(size * (name === 'linkedin-white' ? 779 / 840 : 540 / 635))} class={className} alt="" aria-hidden="true" /> : <Component size={size} stroke-width={strokeWidth} class={className} aria-hidden="true" />}
