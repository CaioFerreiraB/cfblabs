---
import '@fontsource-variable/manrope';
import type { Locale, PageName } from '../lib/content';
import { footer, site } from '../lib/content';
import { assetHref, copy, pageHref, rssHref } from '../lib/i18n';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import '../styles/global.css';

interface Props {
  locale: Locale;
  page: PageName;
  title: string;
  description: string;
  hero?: boolean;
  /** Solid dark header for pages without a hero image. */
  darkHeader?: boolean;
  /** Per-locale URLs of this page; a missing locale means no translation exists. Defaults to the page route in both locales. */
  hrefs?: Partial<Record<Locale, string>>;
}
const { locale, page, title, description, hero = false, darkHeader = false } = Astro.props;
const t = copy[locale];
const hrefs = Astro.props.hrefs ?? { en: pageHref('en', page), pt: pageHref('pt', page) };
const absolute = (href: string) => new URL(href, Astro.site).toString();
const canonical = absolute(hrefs[locale] ?? pageHref(locale, page));
const otherLocale: Locale = locale === 'en' ? 'pt' : 'en';
const alternates = (Object.entries(hrefs) as [Locale, string][]).map(([hreflang, href]) => ({ hreflang, href: absolute(href) }));
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={hero || darkHeader ? '#06182b' : '#f5f7fa'} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href={assetHref('/cfblabs-icon.ico')} />
    <link rel="canonical" href={canonical} />
    {alternates.length > 1 && alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    {alternates.length > 1 && hrefs.en && <link rel="alternate" hreflang="x-default" href={absolute(hrefs.en)} />}
    {page === 'blog' && <link rel="alternate" type="application/rss+xml" title={`${site.brandName} · ${t.blogTitle}`} href={rssHref(locale)} />}
    <title>{title} | {site.brandName}</title>
  </head>
  <body class:list={[{ 'home-body': hero }]}>
    <a class="skip-link" href="#main-content">{t.skip}</a>
    <Header locale={locale} page={page} light={hero} dark={darkHeader} switchHref={hrefs[otherLocale] ?? pageHref(otherLocale, page)} />
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="footer-main container">
        <div class="footer-copy">
          <p class="footer-call">{footer.call[locale]}</p>
          <h2>{footer.title[locale]}</h2>
          <p class="footer-subtitle">{footer.subtitle[locale]}</p>
        </div>
        <div class="footer-actions">
          <a class="button button-primary" href={pageHref(locale, 'contact')}>{footer.contactLabel[locale]}<Icon name="arrow-right" size={18} /></a>
          <nav class="footer-social" aria-label={t.footerSocial}>
            <a href={`mailto:${site.email}`} aria-label={t.email}><Icon name="mail" size={23} /></a>
            <a href={site.linkedin} aria-label={t.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin-white" size={26} /></a>
            <a href={site.github} aria-label={t.github} target="_blank" rel="noopener noreferrer"><Icon name="github-white" size={30} /></a>
          </nav>
        </div>
      </div>
      <div class="footer-bottom"><div class="container"><span>{site.brandName}</span><span>© {new Date().getFullYear()}</span></div></div>
    </footer>
  </body>
</html>
